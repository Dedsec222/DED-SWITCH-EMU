+    case BufferCache::Nx2ListRead::Synced:
+        return GpuWrittenList::Synced;
+    case BufferCache::Nx2ListRead::NeedsSync:
+        return GpuWrittenList::NeedsSync;
+    default:
+        return GpuWrittenList::Unknown;
+    }
