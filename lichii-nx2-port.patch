+    const auto [address, name_errno] = socket.GetSockName();
+    if (name_errno != Network::Errno::SUCCESS) {
+        return name_errno;
+    }
+    host_errno = socket.Connect(address);
+    if (host_errno != Network::Errno::SUCCESS) {
+        return host_errno;
+    }
+    return socket.SetNonBlock(true);
+}
