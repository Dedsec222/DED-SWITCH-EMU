+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstddef>
+#include <deque>
+#include <utility>
+#include <vector>
+
+#include "common/common_types.h"
+
+namespace Service {
+
+class Nx2VideoInputQueue {
+public:
+    struct Input {
+        std::vector<u8> data;
+        u64 pts;
+        bool end;
+    };
+
+    static constexpr size_t ReadyWatermark = 8;
+
+    void Push(Input input) {
+        inputs.push_back(std::move(input));
+    }
+
+    Input Pop() {
+        auto input = std::move(inputs.front());
+        inputs.pop_front();
+        return input;
+    }
+
+    void Clear() {
+        inputs.clear();
+    }
+
+    bool Empty() const {
+        return inputs.empty();
+    }
+
+    size_t Size() const {
+        return inputs.size();
+    }
+
+    bool BelowReadyWatermark() const {
+        return inputs.size() < ReadyWatermark;
+    }
+
+private:
+    std::deque<Input> inputs;
+};
+
+} // namespace Service
diff --git a/src/core/hle/service/nx2_video_ready.h b/src/core/hle/service/nx2_video_ready.h
new file mode 100644
index 0000000000..ab20ef99a5
--- /dev/null
+++ b/src/core/hle/service/nx2_video_ready.h
@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <mutex>
+
+#include "core/hle/kernel/k_event.h"
+
+namespace Service {
+
+struct Nx2VideoReadyState {
+    void Signal(Kernel::KernelCore& kernel) {
+        std::scoped_lock lk{mutex};
+        if (event != nullptr && running &&
+            (room.load(std::memory_order_relaxed) ||
+             output_ready.load(std::memory_order_relaxed))) {
+            event->Signal(kernel);
+        }
+    }
+
+    /// A decoded frame is waiting for the client: wake it now, whatever the input queue level.
+    void SignalOutput(Kernel::KernelCore& kernel) {
+        output_ready.store(true, std::memory_order_relaxed);
+        Signal(kernel);
+    }
+
+    void SetRunning(Kernel::KernelCore& kernel, bool value) {
+        std::scoped_lock lk{mutex};
+        running = value;
+        if (event != nullptr && !running) {
+            event->Clear(kernel);
+        }
+    }
+
+    std::mutex mutex;
+    Kernel::KEvent* event{};
+    std::atomic<bool> room{true};
+    /// Outputs are waiting to be fetched. The client waits on this one event for both input room
+    /// and finished frames: with only `room` (input queue below its watermark) a movie whose tiny
+    /// AV1 frames keep hundreds of inputs queued woke the client only on its ~100 ms timeout,
+    /// playing at ~8 fps.
+    std::atomic<bool> output_ready{false};
+
+private:
+    bool running{true};
+};
+
+} // namespace Service
