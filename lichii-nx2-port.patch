+        auto frame = std::make_shared<FFmpeg::Frame>();
+        AVFrame* f = frame->GetFrame();
+        f->format = AV_PIX_FMT_NV12;
+        f->width = out_width;
+        f->height = out_height;
+        if (av_frame_get_buffer(f, 0) < 0) {
+            return std::nullopt;
+        }
+        f->pts = pts;
+        f->best_effort_timestamp = pts;
+        f->color_range = AVCOL_RANGE_MPEG;
