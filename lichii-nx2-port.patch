diff --git a/src/video_core/host_shaders/dlss_network_probe.comp b/src/video_core/host_shaders/dlss_network_probe.comp
new file mode 100644
index 0000000000..8105d0b059
--- /dev/null
+++ b/src/video_core/host_shaders/dlss_network_probe.comp
@@ -0,0 +1,91 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#version 460 core
+
+// Health check of a game's own DLSS network: one workgroup per block of a coarse grid (the
+// dispatch size) takes the mean brightness of the network's input and of its output over the
+// block, and counts output samples that are NaN or infinite. A working upscaler keeps each
+// block's brightness; a frozen or corrupted network does not.
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(binding = 0) uniform sampler2D input_image;
+layout(binding = 1) uniform sampler2D output_image;
+
+// Per block: input mean, output mean (finite samples only), non-finite output samples, unused.
+layout(binding = 2, std430) writeonly buffer Results {
+    vec4 blocks[];
+};
+
+shared float input_sums[64];
+shared float output_sums[64];
+shared uint invalid_samples;
+
+const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
+
+bool IsFinite(vec3 value) {
+    const uvec3 exponent = floatBitsToUint(value) & 0x7f800000u;
+    return all(notEqual(exponent, uvec3(0x7f800000u)));
+}
+
+void main() {
+    const uint thread = gl_LocalInvocationIndex;
+    if (thread == 0) {
+        invalid_samples = 0;
+    }
+    barrier();
+
+    const ivec2 grid = ivec2(gl_NumWorkGroups.xy);
+    const ivec2 block = ivec2(gl_WorkGroupID.xy);
+    const ivec2 local = ivec2(gl_LocalInvocationID.xy);
+    const ivec2 input_size = textureSize(input_image, 0);
+    const ivec2 output_size = textureSize(output_image, 0);
+    const ivec2 input_begin = block * input_size / grid;
+    const ivec2 input_end = (block + 1) * input_size / grid;
+    const ivec2 output_begin = block * output_size / grid;
+    const ivec2 output_end = (block + 1) * output_size / grid;
+
+    // Every input texel; every second output texel in each direction.
+    float input_sum = 0.0;
+    for (int y = input_begin.y + local.y; y < input_end.y; y += 8) {
+        for (int x = input_begin.x + local.x; x < input_end.x; x += 8) {
+            input_sum += dot(texelFetch(input_image, ivec2(x, y), 0).rgb, LUMA);
+        }
+    }
+    float output_sum = 0.0;
+    uint invalid = 0;
+    for (int y = output_begin.y + local.y * 2; y < output_end.y; y += 16) {
+        for (int x = output_begin.x + local.x * 2; x < output_end.x; x += 16) {
+            const vec3 color = texelFetch(output_image, ivec2(x, y), 0).rgb;
+            if (IsFinite(color)) {
+                output_sum += dot(color, LUMA);
+            } else {
+                ++invalid;
+            }
+        }
+    }
+    input_sums[thread] = input_sum;
+    output_sums[thread] = output_sum;
+    if (invalid != 0) {
+        atomicAdd(invalid_samples, invalid);
+    }
+    barrier();
+    for (uint stride = 32; stride > 0; stride >>= 1) {
+        if (thread < stride) {
+            input_sums[thread] += input_sums[thread + stride];
+            output_sums[thread] += output_sums[thread + stride];
+        }
+        barrier();
+    }
+    if (thread == 0) {
+        const ivec2 input_extent = input_end - input_begin;
+        const ivec2 output_extent = (output_end - output_begin + 1) / 2;
+        const float input_count = float(max(input_extent.x * input_extent.y, 1));
+        const float output_count =
+            float(max(output_extent.x * output_extent.y - int(invalid_samples), 1));
+        blocks[block.y * grid.x + block.x] = vec4(input_sums[0] / input_count,
+                                                  output_sums[0] / output_count,
+                                                  float(invalid_samples), 0.0);
+    }
+}
diff --git a/src/video_core/host_shaders/fsr3_frame_interpolation.comp b/src/video_core/host_shaders/fsr3_frame_interpolation.comp
new file mode 100644
index 0000000000..e33691e801
--- /dev/null
+++ b/src/video_core/host_shaders/fsr3_frame_interpolation.comp
@@ -0,0 +1,106 @@
+#version 460 core
+
+layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
+
+layout(binding = 0) uniform sampler2D CurrentFrame;
+layout(binding = 1) uniform sampler2D PreviousFrame;
+layout(binding = 2) uniform sampler2D MotionVectors;
+layout(binding = 3, rgba8) uniform writeonly image2D OutGeneratedFrame;
+
+layout(push_constant) uniform PushConstants {
+    vec2 inv_render_size;
+    vec2 render_size;
+    float blend_factor; // timestamp between 0.0 and 1.0
+    float flow_scale;
+};
+
+// ΓöÇΓöÇ Optimized 3├ù3 motion vector median using textureGather ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+// textureGather fetches a 2├ù2 quad per call, so we only need 4 calls
+// to cover a 3├ù3 neighbourhood (vs 9 individual texture() calls).
+// We extract the median of X and Y components independently.
+void insertionSort5(inout float a[5]) {
+    for (int i = 1; i < 5; i++) {
+        float key = a[i];
+        int j = i - 1;
+        while (j >= 0 && a[j] > key) {
+            a[j + 1] = a[j];
+            j--;
+        }
+        a[j + 1] = key;
+    }
+}
+
+vec2 sampleMotionMedian(vec2 uv) {
+    vec2 texel = inv_render_size;
+
+    // textureGather returns 2├ù2 quads: (x-0.5, y-0.5) to (x+0.5, y+0.5)
+    // We use 4 gathers offset to cover the 3├ù3 region
+    // Gather component 0 = R (motion X), component 1 = G (motion Y)
+    vec4 gx0 = textureGather(MotionVectors, uv + vec2(-0.5, -0.5) * texel, 0); // TL quad
+    vec4 gx1 = textureGather(MotionVectors, uv + vec2( 0.5, -0.5) * texel, 0); // TR quad
+    vec4 gx2 = textureGather(MotionVectors, uv + vec2(-0.5,  0.5) * texel, 0); // BL quad
+    vec4 gx3 = textureGather(MotionVectors, uv + vec2( 0.5,  0.5) * texel, 0); // BR quad
+
+    vec4 gy0 = textureGather(MotionVectors, uv + vec2(-0.5, -0.5) * texel, 1);
+    vec4 gy1 = textureGather(MotionVectors, uv + vec2( 0.5, -0.5) * texel, 1);
+    vec4 gy2 = textureGather(MotionVectors, uv + vec2(-0.5,  0.5) * texel, 1);
+    vec4 gy3 = textureGather(MotionVectors, uv + vec2( 0.5,  0.5) * texel, 1);
+
+    // Extract 9 unique samples from overlapping 2├ù2 quads
+    // gatherN.w=TL, .z=TR, .x=BL, .y=BR of each quad
+    // 3├ù3 grid: row0=[gx0.w, gx0.z/gx1.w, gx1.z]
+    //           row1=[gx0.x/gx2.w, center, gx1.y/gx3.z]
+    //           row2=[gx2.x, gx2.y/gx3.x, gx3.y]
+    float xs[9] = float[](gx0.w, gx1.w, gx1.z, gx0.x, texture(MotionVectors, uv).x, gx1.y, gx2.x, gx3.x, gx3.y);
+    float ys[9] = float[](gy0.w, gy1.w, gy1.z, gy0.x, texture(MotionVectors, uv).y, gy1.y, gy2.x, gy3.x, gy3.y);
+
+    // Partial sort: only need to find element [4] (median)
+    // Use two passes of 5-element insertion sort on the lower half
+    float xlo[5] = float[](xs[0], xs[1], xs[2], xs[3], xs[4]);
+    float ylo[5] = float[](ys[0], ys[1], ys[2], ys[3], ys[4]);
+    insertionSort5(xlo);
+    insertionSort5(ylo);
+
+    // Insert remaining 4 elements, keeping only the 5 smallest
+    for (int i = 5; i < 9; i++) {
+        if (xs[i] < xlo[4]) { xlo[4] = xs[i]; insertionSort5(xlo); }
+        if (ys[i] < ylo[4]) { ylo[4] = ys[i]; insertionSort5(ylo); }
+    }
+
+    return vec2(xlo[4], ylo[4]);
+}
+
+void main() {
+    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
+    if (pixel_coord.x >= int(render_size.x) || pixel_coord.y >= int(render_size.y)) {
+        return;
+    }
+
+    vec2 uv = (vec2(pixel_coord) + 0.5) * inv_render_size;
+
+    // Median-filtered motion vector (reduces outlier jitter)
+    vec2 motion = sampleMotionMedian(uv) * (flow_scale * inv_render_size);
+
+    // Forward and backward warped coordinates
+    vec2 forward_uv  = clamp(uv - motion * blend_factor,        0.0, 1.0);
+    vec2 backward_uv = clamp(uv + motion * (1.0 - blend_factor), 0.0, 1.0);
+
+    vec4 forward_color  = texture(PreviousFrame, forward_uv);
+    vec4 backward_color = texture(CurrentFrame,  backward_uv);
+
+    // Colour-difference occlusion
+    vec3 color_diff = abs(forward_color.rgb - backward_color.rgb);
+    float occlusion = clamp(dot(color_diff, vec3(0.333)) * 2.0, 0.0, 1.0);
+
+    // Smooth bilateral interpolation ΓÇö bias toward centre on occlusion
+    float alpha = mix(blend_factor, 0.5, occlusion * 0.4);
+    vec4 interpolated = mix(forward_color, backward_color, alpha);
+
+    // ΓöÇΓöÇ Anti-flicker: blend with un-warped centre pixel ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+    float motion_magnitude = length(motion * render_size);
+    float direct_weight = exp(-motion_magnitude * 0.5);
+    vec4 center_color = mix(texture(CurrentFrame, uv), texture(PreviousFrame, uv), blend_factor);
+    interpolated = mix(interpolated, center_color, direct_weight * 0.3);
+
+    imageStore(OutGeneratedFrame, pixel_coord, interpolated);
+}
diff --git a/src/video_core/host_shaders/fsr3_optical_flow.comp b/src/video_core/host_shaders/fsr3_optical_flow.comp
new file mode 100644
index 0000000000..b0e04600cb
--- /dev/null
+++ b/src/video_core/host_shaders/fsr3_optical_flow.comp
@@ -0,0 +1,112 @@
+#version 460 core
+
+layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
+
+layout(binding = 0) uniform sampler2D CurrentFrame;
+layout(binding = 1) uniform sampler2D PreviousFrame;
+layout(binding = 2, rg16f) uniform writeonly image2D OutMotionVectors;
+
+layout(push_constant) uniform PushConstants {
+    vec2 inv_render_size;
+    vec2 render_size;
+    float search_radius;
+    float block_size;
+};
+
+// ΓöÇΓöÇ Shared memory tile cache ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+const uint TILE = 16u;
+const uint BORDER = 2u;
+const uint PADDED = TILE + 2u * BORDER; // 20
+shared float s_curr_luma[PADDED * PADDED];
+
+float rgb2luma(vec3 c) {
+    return dot(c, vec3(0.299, 0.587, 0.114));
+}
+
+void loadTile(ivec2 tile_origin) {
+    uint thread_id = gl_LocalInvocationID.y * TILE + gl_LocalInvocationID.x;
+    for (uint i = thread_id; i < PADDED * PADDED; i += TILE * TILE) {
+        uint lx = i % PADDED;
+        uint ly = i / PADDED;
+        ivec2 coord = tile_origin + ivec2(lx, ly) - ivec2(BORDER);
+        vec2 uv = (vec2(coord) + 0.5) * inv_render_size;
+        s_curr_luma[i] = rgb2luma(texture(CurrentFrame, uv).rgb);
+    }
+    barrier();
+}
+
+float getCachedLuma(ivec2 local_coord) {
+    ivec2 padded = local_coord + ivec2(BORDER);
+    return s_curr_luma[padded.y * PADDED + padded.x];
+}
+
+void main() {
+    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
+
+    ivec2 tile_origin = ivec2(gl_WorkGroupID.xy) * ivec2(TILE);
+    loadTile(tile_origin);
+
+    if (pixel_coord.x >= int(render_size.x) || pixel_coord.y >= int(render_size.y)) {
+        return;
+    }
+
+    vec2 uv = (vec2(pixel_coord) + 0.5) * inv_render_size;
+    ivec2 local = ivec2(gl_LocalInvocationID.xy);
+    float curr_luma = getCachedLuma(local);
+
+    float center_diff = abs(curr_luma - rgb2luma(texture(PreviousFrame, uv).rgb));
+
+    // Early-out only for truly identical pixels (very tight threshold)
+    if (center_diff < 0.002) {
+        imageStore(OutMotionVectors, pixel_coord, vec4(0.0, 0.0, 0.0, 0.0));
+        return;
+    }
+
+    vec2 best_motion = vec2(0.0);
+    float min_diff = center_diff;
+
+    // Large diamond (radius 2)
+    const vec2 diamond_large[4] = vec2[](
+        vec2(0.0, -2.0),
+        vec2(-2.0, 0.0), vec2(2.0, 0.0),
+        vec2(0.0, 2.0)
+    );
+
+    for (int i = 0; i < 4; ++i) {
+        vec2 offset_uv = uv + diamond_large[i] * inv_render_size;
+        float luma = rgb2luma(texture(PreviousFrame, offset_uv).rgb);
+        float d = abs(curr_luma - luma) + 0.04 * length(diamond_large[i]);
+        if (d < min_diff) {
+            min_diff = d;
+            best_motion = diamond_large[i];
+        }
+    }
+
+    // Small refinement diamond (radius 1)
+    const vec2 diamond_small[4] = vec2[](
+        vec2(0.0, -1.0),
+        vec2(-1.0, 0.0), vec2(1.0, 0.0),
+        vec2(0.0, 1.0)
+    );
+
+    vec2 center = best_motion;
+    for (int i = 0; i < 4; ++i) {
+        vec2 cand = center + diamond_small[i];
+        vec2 offset_uv = uv + cand * inv_render_size;
+        float luma = rgb2luma(texture(PreviousFrame, offset_uv).rgb);
+        float d = abs(curr_luma - luma) + 0.04 * length(cand);
+        if (d < min_diff) {
+            min_diff = d;
+            best_motion = cand;
+        }
+    }
+
+    // ΓöÇΓöÇ Dampen very small motions to prevent micro-jitter ΓöÇΓöÇ
+    // Motions below ~0.5 pixels are likely noise, not real movement
+    float motion_len = length(best_motion);
+    if (motion_len < 0.5) {
+        best_motion *= motion_len * 2.0; // smooth fade to zero
+    }
+
+    imageStore(OutMotionVectors, pixel_coord, vec4(best_motion, 0.0, 0.0));
+}
diff --git a/src/video_core/host_shaders/temporal_sharpen.frag b/src/video_core/host_shaders/temporal_sharpen.frag
new file mode 100644
index 0000000000..45a13013cb
--- /dev/null
+++ b/src/video_core/host_shaders/temporal_sharpen.frag
@@ -0,0 +1,49 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// RCAS (FidelityFX FSR 1's contrast-adaptive sharpening) on the DLSS stand-in's result, before the
+// game post-processes it. The input is linear HDR; RCAS's limits assume 0 to 1, so it sharpens in
+// the stand-in's range-compressed space.
+
+#version 460 core
+#extension GL_ARB_separate_shader_objects : enable
+#extension GL_ARB_shading_language_420pack : enable
+#extension GL_GOOGLE_include_directive : enable
+#extension GL_EXT_shader_explicit_arithmetic_types : require
+
+layout(binding = 0) uniform sampler2D InputTexture;
+
+layout(push_constant) uniform PushConstants {
+    // The vertex stage's texture scale and offset come first.
+    layout(offset = 16) uvec4 Const0; // FsrRcasCon
+};
+
+layout(location = 0) in vec2 texcoord;
+layout(location = 0) out vec4 color;
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "ffx_a.h"
+
+vec3 Compress(vec3 c) {
+    return c / (1.0 + max(max(c.r, c.g), c.b));
+}
+
+vec3 Expand(vec3 c) {
+    c = clamp(c, vec3(0.0), vec3(1.0 - 1.0 / 65504.0));
+    return c / (1.0 - max(max(c.r, c.g), c.b));
+}
+
+#define FSR_RCAS_F 1
+AF4 FsrRcasLoadF(ASU2 p) {
+    return AF4(Compress(texelFetch(InputTexture, p, 0).rgb), 1.0);
+}
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
+
+#include "ffx_fsr1.h"
+
+void main() {
+    AF3 c;
+    FsrRcasF(c.r, c.g, c.b, AU2(gl_FragCoord.xy), Const0);
+    color = vec4(Expand(c), 1.0);
+}
diff --git a/src/video_core/host_shaders/temporal_upscale.frag b/src/video_core/host_shaders/temporal_upscale.frag
new file mode 100644
index 0000000000..e21dfd485c
--- /dev/null
+++ b/src/video_core/host_shaders/temporal_upscale.frag
@@ -0,0 +1,186 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Stands in for a game's DLSS evaluation (the tensor-core network cannot run here): a temporal
+// upscale. Each frame's input samples are placed where the camera jitter put them and weighted by
+// their distance to the output pixel; they accumulate with the previous output, reprojected along
+// the game's motion vectors (bicubic) and clipped to the current 3x3 neighbourhood.
+
+#version 450
+
+layout(binding = 0) uniform sampler2D input_color;
+layout(binding = 1) uniform sampler2D motion_vectors;
+layout(binding = 2) uniform sampler2D history;
+layout(binding = 3, rgba16f) uniform writeonly image2D next_history;
+
+layout(push_constant) uniform PushConstants {
+    // The vertex stage's texture scale and offset come first.
+    layout(offset = 16) vec2 jitter;  // this frame's sample offset, in input pixels
+    vec2 motion_scale;                // motion vector -> UV offset to the previous frame
+    float current_weight;             // <0: spatial de-jitter only; 1 ignores the history
+    float kernel_scale;               // accumulation kernel distance scale
+    float clip_width;                 // neighbourhood clip of still pixels, in deviations
+    float clip_motion;                // clip of pixels moving a pixel or more per frame
+    float kernel_motion;              // kernel distance scale of moving pixels
+};
+
+layout(location = 0) in vec2 texcoord;  // 0 to 1 across the output
+layout(location = 0) out vec4 color;
+
+// The blit helper's samplers take unnormalized (texel) coordinates.
+
+// Blending in a range-compressed space keeps bright pixels from dominating the average.
+vec3 Compress(vec3 c) {
+    return c / (1.0 + max(max(c.r, c.g), c.b));
+}
+
+vec3 Expand(vec3 c) {
+    c = clamp(c, vec3(0.0), vec3(1.0 - 1.0 / 65504.0));
+    return c / (1.0 - max(max(c.r, c.g), c.b));
+}
+
+vec3 RgbToYCoCg(vec3 c) {
+    return vec3(dot(c, vec3(0.25, 0.5, 0.25)), dot(c, vec3(0.5, 0.0, -0.5)),
+                dot(c, vec3(-0.25, 0.5, -0.25)));
+}
+
+vec3 YCoCgToRgb(vec3 c) {
+    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
+}
+
+// Moves value towards the box centre until it lies inside the box.
+vec3 ClipToBox(vec3 value, vec3 low, vec3 high) {
+    const vec3 center = 0.5 * (low + high);
+    const vec3 extent = 0.5 * (high - low) + 1.0 / 65504.0;
+    const vec3 offset = value - center;
+    const vec3 units = abs(offset / extent);
+    const float largest = max(units.x, max(units.y, units.z));
+    return largest > 1.0 ? center + offset / largest : value;
+}
+
+// Catmull-Rom filtered history from five bilinear fetches: repeated bilinear reprojection would
+// blur the accumulated image a little more every frame.
+vec3 SampleHistory(vec2 position) {
+    const vec2 texel1 = floor(position - 0.5) + 0.5;
+    const vec2 f = position - texel1;
+    const vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
+    const vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
+    const vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
+    const vec2 w3 = f * f * (-0.5 + 0.5 * f);
+    const vec2 w12 = w1 + w2;
+    const vec2 texel0 = texel1 - 1.0;
+    const vec2 texel3 = texel1 + 2.0;
+    const vec2 texel12 = texel1 + w2 / w12;
+    vec3 sum = textureLod(history, vec2(texel12.x, texel0.y), 0.0).rgb * (w12.x * w0.y);
+    sum += textureLod(history, vec2(texel0.x, texel12.y), 0.0).rgb * (w0.x * w12.y);
+    sum += textureLod(history, texel12, 0.0).rgb * (w12.x * w12.y);
+    sum += textureLod(history, vec2(texel3.x, texel12.y), 0.0).rgb * (w3.x * w12.y);
+    sum += textureLod(history, vec2(texel12.x, texel3.y), 0.0).rgb * (w12.x * w3.y);
+    const float weight = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
+    return max(sum / weight, vec3(0.0));
+}
+
+void main() {
+    const ivec2 input_size = textureSize(input_color, 0);
+    if (current_weight < 0.0) {
+        const vec2 position = clamp(texcoord * vec2(input_size) + jitter,
+                                    vec2(0.5), vec2(input_size) - vec2(0.5));
+        color = vec4(textureLod(input_color, position, 0.0).rgb, 1.0);
+        imageStore(next_history, ivec2(gl_FragCoord.xy), color);
+        return;
+    }
+    const ivec2 motion_size = textureSize(motion_vectors, 0);
+    // The output pixel's centre in input pixels. Input texel k sampled the scene at k + 0.5 - jitter
+    // (the sign measured against consecutive frames).
+    const vec2 target = texcoord * vec2(input_size);
+    const ivec2 nearest = ivec2(floor(target + jitter));
+
+    // The longest motion around the pixel, so that an edge follows the object in front.
+    vec2 motion = vec2(0.0);
+    float longest = -1.0;
+    for (int y = -1; y <= 1; ++y) {
+        for (int x = -1; x <= 1; ++x) {
+            // The motion vectors can be at another scale than the colour (resolution scaling).
+            const ivec2 input_texel = clamp(nearest + ivec2(x, y), ivec2(0), input_size - 1);
+            const ivec2 texel = clamp(ivec2((vec2(input_texel) + 0.5) * vec2(motion_size) /
+                                            vec2(input_size)),
+                                      ivec2(0), motion_size - 1);
+            const vec2 candidate = texelFetch(motion_vectors, texel, 0).rg;
+            const float length_squared = dot(candidate, candidate);
+            if (length_squared > longest) {
+                longest = length_squared;
+                motion = candidate;
+            }
+        }
+    }
+    const vec2 previous = texcoord + motion * motion_scale;
+    // Still pixels: a narrow kernel (detail from many jitter positions accumulates)
+    // and a looser clip (keeps detail only some positions sample, e.g. thin bars). Moving pixels
+    // (a quarter pixel or more per frame): the wide kernel and tight clip, as their history is unreliable.
+    // The history's alpha remembers recent motion, decaying over a few frames: background that a
+    // moving object has just uncovered has no motion of its own but a history of that object.
+    const vec2 history_position = previous * vec2(textureSize(history, 0));
+    const float moved = smoothstep(0.02, 0.25, length(motion * motion_scale * vec2(textureSize(history, 0))));
+    const float moving = max(moved, texture(history, history_position).a);
+    const float kernel = mix(kernel_scale, kernel_motion, moving);
+    const float clip = mix(clip_width, clip_motion, moving);
+
+    vec3 filtered = vec3(0.0);
+    float total_weight = 0.0;
+    float nearest_weight = 0.0;
+    vec3 sum = vec3(0.0);
+    vec3 squares = vec3(0.0);
+    for (int y = -1; y <= 1; ++y) {
+        for (int x = -1; x <= 1; ++x) {
+            const ivec2 texel = clamp(nearest + ivec2(x, y), ivec2(0), input_size - 1);
+            const vec3 sample_color = RgbToYCoCg(Compress(texelFetch(input_color, texel, 0).rgb));
+            // A Blackman-Harris-like window over the sample's distance to the output pixel.
+            const vec2 distance = (vec2(texel) + 0.5 - jitter - target) * kernel;
+            const float weight = exp(-2.29 * dot(distance, distance));
+            filtered += sample_color * weight;
+            total_weight += weight;
+            nearest_weight = max(nearest_weight, weight);
+            sum += sample_color;
+            squares += sample_color * sample_color;
+        }
+    }
+    const vec3 current = filtered / max(total_weight, 1e-6);
+    const vec3 mean = sum / 9.0;
+    const vec3 deviation = sqrt(max(squares / 9.0 - mean * mean, vec3(0.0)));
+    const vec3 low = mean - clip * deviation;
+    const vec3 high = mean + clip * deviation;
+
+    // A frame whose samples land close to this pixel counts more; one whose samples land between
+    // pixels mostly keeps the history (from other jitter positions) there.
+    float weight = current_weight * nearest_weight;
+    vec3 result = current;
+    float remembered = max(moved, 0.85 * moving);
+    if (current_weight >= 1.0 || any(lessThan(previous, vec2(0.0))) ||
+        any(greaterThan(previous, vec2(1.0)))) {
+        // No usable history: the wide kernel, as a narrow one would show the input's pixels.
+        vec3 wide = vec3(0.0);
+        float wide_total = 0.0;
+        for (int y = -1; y <= 1; ++y) {
+            for (int x = -1; x <= 1; ++x) {
+                const ivec2 texel = clamp(nearest + ivec2(x, y), ivec2(0), input_size - 1);
+                const vec2 distance = vec2(texel) + 0.5 - jitter - target;
+                const float wide_weight = exp(-2.29 * dot(distance, distance));
+                wide += RgbToYCoCg(Compress(texelFetch(input_color, texel, 0).rgb)) * wide_weight;
+                wide_total += wide_weight;
+            }
+        }
+        result = wide / wide_total;
+        remembered = 1.0;
+    } else {
+        const vec3 unclipped = RgbToYCoCg(Compress(SampleHistory(history_position)));
+        const vec3 past = ClipToBox(unclipped, low, high);
+        result = mix(past, current, weight);
+        // A history far outside the neighbourhood means the content changed without
+        // motion vectors (some animations have none): treat the pixel as moving for a while.
+        const vec3 extent = 0.5 * (high - low) + 1.0 / 65504.0;
+        const vec3 units = abs(unclipped - 0.5 * (low + high)) / extent;
+        remembered = max(remembered, smoothstep(1.25, 2.5, max(units.x, max(units.y, units.z))));
+    }
+    color = vec4(Expand(YCoCgToRgb(result)), 1.0);
+    imageStore(next_history, ivec2(gl_FragCoord.xy), vec4(color.rgb, remembered));
+}
